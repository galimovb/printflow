# Copy these settings to printflow/.env. Never put seller credentials in API_TOKEN.
PRINTFLOW_WB_ENABLED=1
# Defaults to installed Google Chrome with an independent persistent WB profile.
# PRINTFLOW_WB_BROWSER_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
# PRINTFLOW_WB_BROWSER_PROFILE=D:/NADEL_WORK/ozon-tee/printflow/data/wb_studio/chrome-profile-wb
PRINTFLOW_WB_API_TOKEN=
PRINTFLOW_WB_API_KEY=
PRINTFLOW_WB_PRINTS_BUCKET=tee-prints
PRINTFLOW_WB_MOCKUPS_BUCKET=tee-mockups
# Legacy jobs without stored routing used this single bucket:
PRINTFLOW_WB_BUCKET=tee-prints
PRINTFLOW_WB_COLORS=white,black
# Number of prints, not colour variants. 10 prints * 2 colours = 20 nmID.
# Allowed 1..15, because WB supports up to 30 variants per merged group.
PRINTFLOW_WB_MERGE_DESIGNS=10
PRINTFLOW_WB_WORKERS=3
PRINTFLOW_WB_MAX_ATTEMPTS=3
PRINTFLOW_WB_RETRY_DELAYS_SEC=15,60,180
PRINTFLOW_WB_QUEUE_POLL_SEC=2
PRINTFLOW_WB_ERROR_PAUSE_SEC=5

# Shared cap on concurrent image requests across all WB cards.
PRINTFLOW_WB_IMAGE_CONCURRENCY=6

# Up to two photo requests per print; WORKERS is concurrent prints.
PRINTFLOW_WB_REQUESTS_PER_PRINT=2
